# ANPR System Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Hardware & Inference
DEVICE=cuda
VEHICLE_CONF_THRESHOLD=0.45
PLATE_CONF_THRESHOLD=0.35
OCR_CONF_THRESHOLD=0.40

# Paths (Relative to backend or absolute)
MODEL_DIR=../model_weights
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Database
DATABASE_URL=sqlite:///./anpr.db

# Traffic Violation Settings
VIOLATION_LINE_Y_RATIO=0.65
VIOLATION_DWELL_SECONDS=1.0

# Retention Policy (days, 0 = indefinite)
DATA_RETENTION_DAYS=30
